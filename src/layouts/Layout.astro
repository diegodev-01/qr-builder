---
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>QR Builder</title>
    <ClientRouter />
  </head>
  <body>
    <Header />
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    padding: 0;
    font-family: Roboto, sans-serif;
  }

  /* min-height (not height) so content can grow and the page scrolls
     with the body, keeping the sticky header and bottom nav correct. */
  body {
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    min-height: 100vh;
    min-height: 100dvh;
  }

  @media screen and (max-width: 768px) {
    body {
      /* Reserve space for the fixed bottom nav so nothing hides behind it. */
      padding-bottom: calc(5rem + env(safe-area-inset-bottom));
    }
  }
</style>
